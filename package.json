{
  "name": "mkt-seo-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS for SEO pipeline: keyword research, AI content generation, WordPress publishing.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "db:generate": "pnpm --filter @mkt-seo/database generate",
    "db:migrate": "pnpm --filter @mkt-seo/database migrate",
    "db:migrate:deploy": "pnpm --filter @mkt-seo/database migrate:deploy",
    "db:seed": "pnpm --filter @mkt-seo/database seed",
    "db:studio": "pnpm --filter @mkt-seo/database studio",
    "db:reset": "pnpm --filter @mkt-seo/database reset",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "pnpm exec prettier --write",
      "pnpm exec eslint --fix --max-warnings=0 --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yml,yaml,css}": [
      "pnpm exec prettier --write"
    ]
  }
}
