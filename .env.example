# ===== Application =====
NODE_ENV=development
PORT=3005
WEB_PORT=3006

# Application URLs (placeholder — update when domain finalized)
APP_URL=http://localhost:3006
API_URL=http://localhost:3005
PUBLIC_APP_NAME="MKT SEO AI"

# ===== Database =====
# Docker compose exposes Postgres on host 5434 (container 5432) to avoid conflict
# with other dev projects already using 5432/5433. Redis exposed on host 6380.
DATABASE_URL=postgresql://mkt:mkt_dev_pw@localhost:5434/mkt_seo_dev?schema=public
# Separate DB for integration tests (Task 1.4)
TEST_DATABASE_URL=postgresql://mkt:mkt_dev_pw@localhost:5434/mkt_seo_test?schema=public
REDIS_URL=redis://localhost:6380

# ===== Auth =====
# Generate: openssl rand -hex 32
JWT_SECRET=change_me_to_a_64_char_hex_secret_in_real_env_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ===== CORS =====
CORS_ORIGINS=http://localhost:3006

# ===== AI Providers =====
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
REPLICATE_API_TOKEN=r8_...

# ===== External APIs =====
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
BRIGHTDATA_USERNAME=
BRIGHTDATA_PASSWORD=
SCRAPERAPI_KEY=
TINYPNG_API_KEY=

# ===== Cloudflare R2 =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=mkt-seo-images-dev
R2_PUBLIC_URL=

# ===== Payment =====
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
SEPAY_API_KEY=

# ===== Notifications =====
# Email: stub mode logs to console + email_outbox table when key empty
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com
TELEGRAM_BOT_TOKEN=

# ===== Monitoring =====
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=debug

# ===== Encryption (Section 17) =====
# Master key for AES-256-GCM credential encryption. 32 bytes hex (openssl rand -hex 32).
ENCRYPTION_MASTER_KEY=change_me_64_char_hex_master_key_for_wp_credentials_xxxxxxxxxxxxxxx

# ===== Proxy provider switch =====
# Values: scraperapi | brightdata | none
PROXY_PROVIDER=none
