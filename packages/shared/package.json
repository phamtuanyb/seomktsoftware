{
  "name": "@mkt-seo/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types and constants between API and Web. Source-only — consumers compile via tsx/ts-loader/Next.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly --outDir ./dist",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "echo 'no tests yet' && exit 0",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@mkt-seo/config": "workspace:*",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "typescript": "^5.7.2"
  }
}
